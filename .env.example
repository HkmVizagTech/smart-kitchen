# Copy this file to .env and fill in values.
# NEVER commit the real .env — it is in .gitignore. Keep it that way.

# Postgres connection string.
# Local dev: use a local Postgres, or a separate Railway database.
# On Railway, set this as a VARIABLE on the api service, referencing the
# database service so it rotates with it:
#     DATABASE_URL = ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME"

# API server port (Railway sets PORT automatically in production).
PORT=4000

# Secret used to sign login tokens. REQUIRED — the API refuses to start in
# production without it. Generate a fresh one with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing this signs everybody out, which is exactly what you want after a leak.
AUTH_SECRET="change-me-generate-a-random-one"

# Shared secret for uploading OTA app bundles (used by push-update.sh).
UPDATE_SECRET="change-me-generate-a-random-one"

# --- optional ---

# How long a login lasts before the user must sign in again. Default 30.
# TOKEN_TTL_DAYS=30

# Timezone all booking deadlines are evaluated in. Default Asia/Kolkata.
# Railway containers run UTC, so this must NOT be left to the system clock.
# APP_TIMEZONE="Asia/Kolkata"

# Roles a stranger may create for themselves at /auth/signup.
# Default BOOKING. Kitchen, verification and super-admin accounts are created
# by a Super Admin from the admin console. Do not add SUPER_ADMIN here.
# SELF_SIGNUP_ROLES="BOOKING"

# How many proxies sit in front of the API, for working out the caller's real
# address. Railway's edge is one hop, which is the default. Getting this wrong
# has consequences in both directions: too high and a client can forge its
# address to walk around the login rate limit; too low and every caller looks
# like the same platform-internal address, so one person hitting the limit
# locks out the whole kitchen. Only change it if the platform adds a hop.
# TRUSTED_PROXY_HOPS=1

# Login and signup throttling, per address. Defaults are 10 logins a minute and
# 5 signups an hour. Raising the login limit is reasonable if a whole site
# shares one outbound address; lowering it is not, it is the only thing
# standing between the login form and a password guesser.
# LOGIN_RATE_LIMIT=10
# LOGIN_RATE_WINDOW_MS=60000
# SIGNUP_RATE_LIMIT=5
# SIGNUP_RATE_WINDOW_MS=3600000

# Password given to the four starter accounts the seed creates. Used once, on a
# fresh database. Leave it unset in production and the seed prints a random one.
# SEED_PASSWORD=
