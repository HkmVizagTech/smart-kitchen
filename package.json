{
  "name": "smart-kitchen",
  "version": "0.1.0",
  "private": true,
  "description": "Smart Kitchen Indent & Packing Management System",
  "scripts": {
    "db:generate": "pnpm --filter @sk/db generate",
    "db:push": "pnpm --filter @sk/db push",
    "db:reset": "pnpm --filter @sk/db reset",
    "db:seed": "pnpm --filter @sk/db seed",
    "db:studio": "pnpm --filter @sk/db studio",
    "api:dev": "pnpm --filter @sk/api dev",
    "api:start": "pnpm --filter @sk/api start",
    "web": "pnpm --filter @sk/web dev",
    "build": "pnpm --filter @sk/web build",
    "typecheck": "pnpm --filter @sk/api typecheck && pnpm --filter @sk/web typecheck",
    "dev": "concurrently -n api,web -c yellow,green \"pnpm api:dev\" \"pnpm web\""
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.16.2",
    "@types/node": "^20.14.12",
    "concurrently": "^8.2.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "serve": "^14.2.3"
  }
}
